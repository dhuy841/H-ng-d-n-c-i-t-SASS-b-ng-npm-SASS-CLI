{
  "name": "sass-cli-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Ví dụ biên dịch SCSS sang CSS bằng Sass CLI",
  "scripts": {
    "build": "node ./node_modules/sass/sass.js --no-source-map scss:css",
